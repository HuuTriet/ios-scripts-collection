#!name=Locket Gold Full Effects
#!desc=Mở khóa Locket Gold + toàn bộ hiệu ứng (45s video, camera roll, filter, badge...)
#!author=NightmarketServer (Clone by Triet)

[Script]
# 1. Fake RevenueCat (Gold subscription)
revenuecat = type=http-response, \
pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/locketfix8.js, \
requires-body=true, max-size=-1, timeout=60

# 2. Xóa header ETag để luôn nhận dữ liệu mới
deleteHeader = type=http-request, \
pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/header7.js, \
timeout=60

# 3. Force Remote Config (toàn bộ hiệu ứng + tính năng Gold)
locket_rc = type=http-response, \
pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/forceGold4.3.js, \
requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
