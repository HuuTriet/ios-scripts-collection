#!name=Locket Gold
#!desc=Mở khóa Locket Gold + toàn bộ hiệu ứng

[Script]
# Patch response RevenueCat — receipts, subscribers, offerings
Locket_Premium = type=http-response, \
pattern=^https:\/\/api\.revenuecat\.com\/v\d\/(receipts|subscribers(\/[^\/]+)?(\/offerings)?|subscribers\/identify), \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/Locket_Triet.js, \
requires-body=true, max-size=-1, timeout=60

# Backup host (một số phiên bản RevenueCat dùng rc-backup)
Locket_Premium_Backup = type=http-response, \
pattern=^https:\/\/api\.rc-backup\.com\/v\d\/(receipts|subscribers(\/[^\/]+)?(\/offerings)?|subscribers\/identify), \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/Locket_Triet.js, \
requires-body=true, max-size=-1, timeout=60

# Xóa header gây cache 304 (request + response)
Locket_CleanHeader = type=http-request, \
pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/CleanHeader.js, \
timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
