#!name=Locket Gold + Mino Full
#!desc=Gold + Video 45s + Photobooth qua Vercel
#!author=Triet

[Script]
# 1. RevenueCat lo phần Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/locketfix8.js, requires-body=true, max-size=-1, timeout=60

# 2. Firebase lo phần Video 45s
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/forceGold4.3.js, requires-body=true, max-size=-1, timeout=60

# 3. Xóa Cache Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/header7.js, timeout=60

# 4. API Locket (Cảnh sát bẻ hướng sang Vercel)
locket_mino = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/locketmino.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
