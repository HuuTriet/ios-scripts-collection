#!name=Locket Gold Full Effects
#!desc=Mở khóa Locket Gold + toàn bộ hiệu ứng
#!author=Triet

[Script]
# 1. RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/locketfix8.js, requires-body=true, max-size=-1, timeout=60

# 2. Xóa Header cache
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/header7.js, timeout=60

# 3. Firebase (Đã nới lỏng regex bắt mọi Project ID)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/forceGold4.3.js, requires-body=true, max-size=-1, timeout=60

# 4. API Locket Camera (Đấm thẳng server)
locket_api = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/locketapi.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
