#!name=Locket Gold by Triet (Full)
#!desc=Mở khóa Gold + toàn bộ hiệu ứng (45s video, filter, badge, chặn ads)
#!author=HuuTriet
#!homepage=https://github.com/HuuTriet

[Script]
# 1. RevenueCat
Locket_RC = type=http-response, \
pattern=^https:\/\/api\.revenuecat\.com\/.+, \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/Locket_Triet.js, \
requires-body=true, max-size=-1, timeout=60

# 2. Firebase
Locket_Firebase = type=http-response, \
pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+, \
script-path=https://raw.githubusercontent.com/HuuTriet/ios-scripts-collection/main/Locket_Firebase.js, \
requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com
